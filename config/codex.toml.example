# Codex Harness 配置示例
# 复制到 ~/.codex/config.toml 后改

# Provider（默认 OpenAI，可加自定义）
[provider]
name = "openai"
api_key = "<你的 OpenAI API key>"

# Agent 默认设置
[agent]
# 默认模型（gpt-5 / gpt-4o / o3 等）
model = "gpt-5"
# 每个 turn 的最大 token
max_tokens = 8192
# temperature
temperature = 0.7

# Permission 设置
[permission]
# auto-content-pipeline 涉及的危险操作
# Codex 默认会在这些操作前问 linc 确认
[permission.rules.publish]
tool = "shell"
command = "python3 ~/.openclaw/workspace/xiaohongshu_poster.py"
prompt = "publish 到小红书"
requires_user_approval = true

[permission.rules.delete]
tool = "shell"
command = "rm -rf"
requires_user_approval = true

[permission.rules.write_vault]
tool = "shell"
command = "写入 ~/Documents/Obsidian Vault"
requires_user_approval = false  # 写 vault 不用问

# Tool 注册：把我们的工具给 Codex
[[tools]]
name = "image_generate"
description = "生成封面/正文配图（黑底白字单色调，按 dankoe 模板）"
command = "openclaw image-generate"

[[tools]]
name = "xiaohongshu_post"
description = "发布文章到小红书"
command = "python3 ~/.openclaw/workspace/xiaohongshu_poster.py post"

[[tools]]
name = "vault_read"
description = "读 Obsidian vault 里的文件"
command = "vault-read"

[[tools]]
name = "vault_write"
description = "写 Obsidian vault 里的文件"
command = "vault-write"

# Memory 持久化
[memory]
# 跨 session 保留对话上下文
persistent = true
# memory 文件位置（默认 ~/.codex/memory.json）
path = "~/.codex/memory.json"

# Session log（Codex 自动记）
[session]
# 每个 session 留 log，方便回放
log_dir = "~/.codex/sessions/"
